# Supabase project (Dashboard → Project Settings → API Keys). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local only, for `npm run db:migrate` (Dashboard → Connect → Session pooler URI). Contains the database password:
# never expose it to the browser or add it to the hosting provider.
SUPABASE_DB_URL=

# Supabase secret key (Dashboard → Project Settings → API Keys → Secret keys). Server only: used to save orders,
# bypasses row-level security. Add it to the hosting provider, but never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Razorpay (Dashboard → Account & Settings → API Keys). Use Test Mode keys locally and Live Mode keys in production.
# Server only: the Key ID is sent to the browser by the checkout action, the secret never is.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL https://www.veronaarts.com/api/razorpay/webhook, events order.paid and payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Resend (resend.com → API Keys) for order emails. Server only. The sender domain must be verified in Resend.
RESEND_KEY=
# Optional overrides: sender address and the inbox that gets new-order alerts.
# EMAIL_FROM="Verona Arts <orders@veronaarts.com>"
# ORDER_NOTIFY_EMAIL=info@veronaarts.com
