# Supabase project (Dashboard → Project Settings → API Keys). Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local only, for `npm run db:migrate` (Dashboard → Connect → Session pooler URI). Contains the database password:
# never expose it to the browser or add it to the hosting provider.
SUPABASE_DB_URL=
